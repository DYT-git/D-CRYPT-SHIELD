# ============================================================
# VASP Attribution Engine - Environment Variables
# Copy this to .env and fill in real API keys.
# NEVER commit the real .env file to git.
# ============================================================

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=vasp_user
POSTGRES_PASSWORD=vaspengine123
POSTGRES_DB=vasp_db
POSTGRES_URL=postgresql://vasp_user:vaspengine123@localhost:5432/vasp_db

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=vaspengine123

# --- Redis ---
REDIS_URL=redis://:vaspengine123@localhost:6379/0

# --- Go Backend Core ---
GO_SERVER_PORT=8080
GO_ENV=development          # development | production
MAX_TRACE_DEPTH=10          # Max BFS hops before giving up
MIN_TX_VALUE_USD=10         # Ignore transactions below this USD value (filter dust)

# --- Python Intelligence Service ---
PYTHON_SERVICE_PORT=8001
PYTHON_ENV=development

# --- Blockchain Data Providers (Free Tier API Keys) ---
# Get free keys at: https://bitquery.io
BITQUERY_API_KEY=your_bitquery_key_here

# Get free key at: https://etherscan.io/apis
ETHERSCAN_API_KEY=your_etherscan_key_here

# Get free key at: https://www.bscscan.com/apis
BSCSCAN_API_KEY=your_bscscan_key_here

# Get free key at: https://polygonscan.com/apis
POLYGONSCAN_API_KEY=your_polygonscan_key_here

# Get free key at: https://snowtrace.io/apis  (Avalanche)
SNOWTRACE_API_KEY=your_snowtrace_key_here

# Get free key at: https://ftmscan.com/apis  (Fantom)
FTMSCAN_API_KEY=your_ftmscan_key_here

# Trongrid (free, no key needed for basic usage)
TRONGRID_API_URL=https://api.trongrid.io

# Solana (free public RPC — no key needed)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Bitcoin / Dogecoin / Litecoin (via Blockchair — free tier, no key needed for demo)
# Get key at: https://blockchair.com/api (optional, increases rate limit)
BLOCKCHAIR_API_KEY=your_blockchair_key_here

# KEY POOLING — add multiple keys separated by commas to rotate and avoid rate limits:
# ETHERSCAN_API_KEY=key1,key2,key3

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_PYTHON_API_URL=http://localhost:8001
